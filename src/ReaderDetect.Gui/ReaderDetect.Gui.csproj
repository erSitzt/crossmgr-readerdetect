<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReaderDetect.Gui</RootNamespace>
    <AssemblyName>readerdetect-gui</AssemblyName>
    <PackageId>ReaderDetect.Gui</PackageId>
    <RollForward>Major</RollForward>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets the Windows-only GUI at least compile on a Mac/Linux dev box or
         CI runner; it can only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ReaderDetect/ReaderDetect.csproj" />
    <ProjectReference Include="../ReaderDetect.Management/ReaderDetect.Management.csproj" />
  </ItemGroup>

</Project>
